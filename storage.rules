rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|jpg|png|webp|svg\\+xml)$');
    }

    // Public center images & assets: readable by anyone, writeable by signed-in users
    match /centers/{centerId}/public/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && isAllowedImage();
      allow delete: if signedIn();
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isAllowedImage();
      allow delete: if signedIn();
    }
  }
}
