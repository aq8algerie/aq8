rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Les images publiques de centres sont ecrites exclusivement par l API
    // Firebase Admin apres controle du role et du centre.
    match /centers/{centerId}/public/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Les medias editoriaux sont televerses exclusivement par l API Super Admin.
    match /blog/{postId}/{usage}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
