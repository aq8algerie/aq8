# Firebase Web SDK (public browser configuration, not secrets)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
# Audience measurement stays disabled unless explicitly enabled after consent review.
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED="false"

# Public application URL
APP_URL="https://www.example.com"
NEXT_PUBLIC_APP_URL="https://www.example.com"

# Keep demo shortcuts disabled outside local development.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"

# Firebase Admin local fallback. App Hosting uses application credentials.
FIREBASE_ADMIN_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_ADMIN_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
# FIREBASE_ADMIN_CLIENT_EMAIL="service-account@YOUR_PROJECT.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Transactional email through Resend.
# Store RESEND_API_KEY in Secret Manager in production; never commit a real key.
EMAIL_NOTIFICATIONS_ENABLED="true"
EMAIL_ADMIN_COPIES_ENABLED="false"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
EMAIL_FROM="AQ8 Algerie <notifications@example.com>"
EMAIL_REPLY_TO="notifications@example.com"
ADMIN_NOTIFICATION_EMAILS="admin@example.com"
