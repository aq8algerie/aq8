rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveCrmUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true;
    }

    function isSuperAdmin() {
      return isActiveCrmUser() && userProfile().role == 'super_admin';
    }

    function isCenterManager(centerId) {
      return isActiveCrmUser()
        && userProfile().role == 'center_manager'
        && userProfile().centerId == centerId;
    }

    function canAccessCenter(centerId) {
      return isSuperAdmin() || isCenterManager(centerId);
    }

    function isBookingCapacityMap(value) {
      return value is map
        && value.keys().hasOnly(['aq8', 'wonder'])
        && (!('aq8' in value) || (value.aq8 is number && value.aq8 >= 0 && value.aq8 <= 20))
        && (!('wonder' in value) || (value.wonder is number && value.wonder >= 0 && value.wonder <= 20));
    }

    function isTimeRange(value) {
      return value is map
        && value.keys().hasOnly(['start', 'end'])
        && value.start is string
        && value.end is string
        && value.start.matches('^([01][0-9]|2[0-3]):00$')
        && value.end.matches('^([01][0-9]|2[0-4]):00$');
    }

    function isBookingDayRanges(value) {
      return value is list
        && value.size() <= 4
        && (value.size() == 0 || isTimeRange(value[0]))
        && (value.size() <= 1 || isTimeRange(value[1]))
        && (value.size() <= 2 || isTimeRange(value[2]))
        && (value.size() <= 3 || isTimeRange(value[3]));
    }

    function isBookingHoursMap(value) {
      return value is map
        && value.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && (!('0' in value) || isBookingDayRanges(value['0']))
        && (!('1' in value) || isBookingDayRanges(value['1']))
        && (!('2' in value) || isBookingDayRanges(value['2']))
        && (!('3' in value) || isBookingDayRanges(value['3']))
        && (!('4' in value) || isBookingDayRanges(value['4']))
        && (!('5' in value) || isBookingDayRanges(value['5']))
        && (!('6' in value) || isBookingDayRanges(value['6']));
    }

    function isPublicTextList(value, maxItems, maxSize) {
      return value is list
        && value.size() <= maxItems
        && (value.size() == 0 || (value[0] is string && value[0].size() <= maxSize))
        && (value.size() <= 1 || (value[1] is string && value[1].size() <= maxSize))
        && (value.size() <= 2 || (value[2] is string && value[2].size() <= maxSize))
        && (value.size() <= 3 || (value[3] is string && value[3].size() <= maxSize))
        && (value.size() <= 4 || (value[4] is string && value[4].size() <= maxSize))
        && (value.size() <= 5 || (value[5] is string && value[5].size() <= maxSize))
        && (value.size() <= 6 || (value[6] is string && value[6].size() <= maxSize))
        && (value.size() <= 7 || (value[7] is string && value[7].size() <= maxSize))
        && (value.size() <= 8 || (value[8] is string && value[8].size() <= maxSize))
        && (value.size() <= 9 || (value[9] is string && value[9].size() <= maxSize))
        && (value.size() <= 10 || (value[10] is string && value[10].size() <= maxSize))
        && (value.size() <= 11 || (value[11] is string && value[11].size() <= maxSize))
        && (value.size() <= 12 || (value[12] is string && value[12].size() <= maxSize))
        && (value.size() <= 13 || (value[13] is string && value[13].size() <= maxSize))
        && (value.size() <= 14 || (value[14] is string && value[14].size() <= maxSize))
        && (value.size() <= 15 || (value[15] is string && value[15].size() <= maxSize))
        && (value.size() <= 16 || (value[16] is string && value[16].size() <= maxSize))
        && (value.size() <= 17 || (value[17] is string && value[17].size() <= maxSize))
        && (value.size() <= 18 || (value[18] is string && value[18].size() <= maxSize))
        && (value.size() <= 19 || (value[19] is string && value[19].size() <= maxSize));
    }

    function isCenterManagerSettingsUpdate(centerId) {
      return isCenterManager(centerId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bookingCapacity', 'bookingHours', 'phone', 'email', 'address', 'imageUrl', 'schedule',
          'description', 'importantNotes', 'menHours', 'womenHours', 'equipment',
          'cancellationRule', 'updatedAt'
        ])
        && (!('bookingCapacity' in request.resource.data) || isBookingCapacityMap(request.resource.data.bookingCapacity))
        && (!('bookingHours' in request.resource.data) || isBookingHoursMap(request.resource.data.bookingHours))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 60))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 240))
        && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 500))
        && (!('schedule' in request.resource.data) || (request.resource.data.schedule is string && request.resource.data.schedule.size() <= 300))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
        && (!('importantNotes' in request.resource.data) || isPublicTextList(request.resource.data.importantNotes, 20, 500))
        && (!('menHours' in request.resource.data) || isPublicTextList(request.resource.data.menHours, 20, 200))
        && (!('womenHours' in request.resource.data) || isPublicTextList(request.resource.data.womenHours, 20, 200))
        && (!('equipment' in request.resource.data) || isPublicTextList(request.resource.data.equipment, 20, 200))
        && (!('cancellationRule' in request.resource.data) || (request.resource.data.cancellationRule is string && request.resource.data.cancellationRule.size() <= 1200))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string);
    }

    function isNullableString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    function isAuditLogCreate() {
      return isActiveCrmUser()
        && request.resource.data.keys().hasOnly([
          'timestamp', 'userId', 'userName', 'role', 'action', 'details',
          'targetId', 'targetType', 'centerId', 'centerName'
        ])
        && request.resource.data.keys().hasAll([
          'timestamp', 'userId', 'userName', 'role', 'action', 'details',
          'targetId', 'targetType', 'centerId', 'centerName'
        ])
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 160
        && request.resource.data.role == userProfile().role
        && request.resource.data.role in ['super_admin', 'center_manager']
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 2000
        && isNullableString(request.resource.data.targetId, 160)
        && isNullableString(request.resource.data.targetType, 80)
        && isNullableString(request.resource.data.centerId, 80)
        && isNullableString(request.resource.data.centerName, 160)
        && (userProfile().role == 'super_admin' || request.resource.data.centerId == userProfile().centerId);
    }

    function isBookingRequestDecision() {
      return resource.data.status == 'pending'
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.processedByUserId == request.auth.uid
        && request.resource.data.processedAt is string
        && (
          (
            request.resource.data.status == 'accepted'
            && request.resource.data.clientId is string
            && request.resource.data.appointmentId is string
            && request.resource.data.acceptedAt == request.resource.data.processedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'clientId', 'appointmentId', 'processedAt',
              'processedByUserId', 'processedByUserName', 'acceptedAt'
            ])
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectedAt == request.resource.data.processedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'processedAt', 'processedByUserId',
              'processedByUserName', 'rejectedAt'
            ])
          )
        );
    }

    function isClientCreate() {
      return request.resource.data.status == 'active'
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 160
        && request.resource.data.centerId is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && !request.resource.data.keys().hasAny([
          'archivedAt', 'archivedByUserId', 'archivedByUserName',
          'suspendedAt', 'reactivatedAt'
        ]);
    }

    function isBookedAppointmentCreate() {
      return request.resource.data.status == 'booked'
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 160
        && request.resource.data.centerId is string
        && request.resource.data.clientId is string
        && request.resource.data.serviceId is string
        && request.resource.data.dateTime is string
        && request.resource.data.duration is number
        && request.resource.data.duration > 0
        && !request.resource.data.keys().hasAny([
          'completedAt', 'completedByUserId', 'completedByUserName',
          'completedWithClientPackageId', 'deductedCredits',
          'cancelledAt', 'cancelledByUserId', 'cancelledByUserName'
        ]);
    }

    function isAppointmentReschedule() {
      return resource.data.status == 'booked'
        && request.resource.data.status == 'booked'
        && request.resource.data.id == resource.data.id
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId', 'serviceId', 'dateTime', 'duration', 'notes', 'updatedAt'
        ]);
    }

    function isAppointmentCancellation() {
      return resource.data.status == 'booked'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.id == resource.data.id
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.serviceId == resource.data.serviceId
        && request.resource.data.dateTime == resource.data.dateTime
        && request.resource.data.duration == resource.data.duration
        && request.resource.data.cancelledByUserId == request.auth.uid
        && request.resource.data.cancelledAt is string
        && request.resource.data.cancellationReason is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledByUserId', 'cancelledByUserName',
          'cancellationReason', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      // Les roles et revocations sont administres uniquement par Firebase Admin.
      allow create, update, delete: if false;
    }

    match /centers/{centerId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isCenterManagerSettingsUpdate(centerId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /managers/{managerId} {
      allow read: if isSuperAdmin() || isCenterManager(resource.data.centerId);
      // Le cycle de vie Auth + profil + manager passe par /api/crm-managers.
      allow create, update, delete: if false;
    }

    match /clients/{clientId} {
      allow get: if (isActiveCrmUser() && !exists(/databases/$(database)/documents/clients/$(clientId)))
        || canAccessCenter(resource.data.centerId);
      allow list: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId)
        && isClientCreate();
      // Profile edits, suspension and archival are handled by /api/crm-clients.
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get: if (isActiveCrmUser() && !exists(/databases/$(database)/documents/appointments/$(appointmentId)))
        || canAccessCenter(resource.data.centerId);
      allow list: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId)
        && isBookedAppointmentCreate();
      // Session completion and credit mutations are handled by the authenticated
      // /api/crm-operations route through Firebase Admin.
      allow update: if canAccessCenter(resource.data.centerId)
        && canAccessCenter(request.resource.data.centerId)
        && (isAppointmentReschedule() || isAppointmentCancellation());
      allow delete: if false;
    }

    match /client_packages/{clientPackageId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create, update, delete: if false;
    }

    match /measurements/{measurementId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId);
      allow update: if canAccessCenter(resource.data.centerId) && canAccessCenter(request.resource.data.centerId);
      allow delete: if canAccessCenter(resource.data.centerId);
    }

    match /appointment_slots/{centerId}/slots/{slotId} {
      allow read: if canAccessCenter(centerId);
      allow create: if canAccessCenter(centerId) && request.resource.data.centerId == centerId;
      allow update: if canAccessCenter(centerId)
        && resource.data.centerId == centerId
        && request.resource.data.centerId == centerId;
      allow delete: if canAccessCenter(centerId) && resource.data.centerId == centerId;
    }

    match /public_booking_slots/{centerId}/slots/{slotId} {
      allow read: if true;
      allow create: if canAccessCenter(centerId) && request.resource.data.centerId == centerId;
      allow update: if canAccessCenter(centerId)
        && resource.data.centerId == centerId
        && request.resource.data.centerId == centerId;
      allow delete: if canAccessCenter(centerId) && resource.data.centerId == centerId;
    }

    match /booking_requests/{requestId} {
      allow create: if false;
      allow read: if canAccessCenter(resource.data.centerId);
      allow update: if canAccessCenter(resource.data.centerId)
        && canAccessCenter(request.resource.data.centerId)
        && isBookingRequestDecision();
      allow delete: if false;
    }

    match /contact_messages/{messageId} {
      // Public submissions pass through the rate-limited server API.
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuditLogCreate();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
