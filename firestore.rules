rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveCrmUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true;
    }

    function isSuperAdmin() {
      return isActiveCrmUser() && userProfile().role == 'super_admin';
    }

    function isOperationalCenter(centerId) {
      return exists(/databases/$(database)/documents/centers/$(centerId))
        && (
          !('status' in get(/databases/$(database)/documents/centers/$(centerId)).data)
          || !(get(/databases/$(database)/documents/centers/$(centerId)).data.status in [
            'suspended', 'showcase', 'inactive', 'archived'
          ])
        );
    }

    function isCenterManager(centerId) {
      return isActiveCrmUser()
        && userProfile().role == 'center_manager'
        && userProfile().centerId == centerId
        && isOperationalCenter(centerId);
    }

    function canAccessCenter(centerId) {
      return isSuperAdmin() || isCenterManager(centerId);
    }

    function isActiveClientForCenterAfter(clientId, centerId) {
      let client = getAfter(/databases/$(database)/documents/clients/$(clientId)).data;
      return client.centerId == centerId
        && (!('status' in client) || client.status == 'active');
    }

    function isKnownService(serviceId) {
      return exists(/databases/$(database)/documents/services/$(serviceId));
    }

    function isOptionalNumber(value, minimum, maximum) {
      return value == null || (value is number && value >= minimum && value <= maximum);
    }

    function isPublicTextList(value, maxItems, maxSize) {
      return value is list
        && value.size() <= maxItems
        && (value.size() == 0 || (value[0] is string && value[0].size() <= maxSize))
        && (value.size() <= 1 || (value[1] is string && value[1].size() <= maxSize))
        && (value.size() <= 2 || (value[2] is string && value[2].size() <= maxSize))
        && (value.size() <= 3 || (value[3] is string && value[3].size() <= maxSize))
        && (value.size() <= 4 || (value[4] is string && value[4].size() <= maxSize))
        && (value.size() <= 5 || (value[5] is string && value[5].size() <= maxSize))
        && (value.size() <= 6 || (value[6] is string && value[6].size() <= maxSize))
        && (value.size() <= 7 || (value[7] is string && value[7].size() <= maxSize))
        && (value.size() <= 8 || (value[8] is string && value[8].size() <= maxSize))
        && (value.size() <= 9 || (value[9] is string && value[9].size() <= maxSize))
        && (value.size() <= 10 || (value[10] is string && value[10].size() <= maxSize))
        && (value.size() <= 11 || (value[11] is string && value[11].size() <= maxSize))
        && (value.size() <= 12 || (value[12] is string && value[12].size() <= maxSize))
        && (value.size() <= 13 || (value[13] is string && value[13].size() <= maxSize))
        && (value.size() <= 14 || (value[14] is string && value[14].size() <= maxSize))
        && (value.size() <= 15 || (value[15] is string && value[15].size() <= maxSize))
        && (value.size() <= 16 || (value[16] is string && value[16].size() <= maxSize))
        && (value.size() <= 17 || (value[17] is string && value[17].size() <= maxSize))
        && (value.size() <= 18 || (value[18] is string && value[18].size() <= maxSize))
        && (value.size() <= 19 || (value[19] is string && value[19].size() <= maxSize));
    }

    function isNullableString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    function isAuditLogCreate() {
      return isActiveCrmUser()
        && request.resource.data.keys().hasOnly([
          'timestamp', 'userId', 'userName', 'role', 'action', 'details',
          'targetId', 'targetType', 'centerId', 'centerName'
        ])
        && request.resource.data.keys().hasAll([
          'timestamp', 'userId', 'userName', 'role', 'action', 'details',
          'targetId', 'targetType', 'centerId', 'centerName'
        ])
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 160
        && request.resource.data.role == userProfile().role
        && request.resource.data.role in ['super_admin', 'center_manager']
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && (
          userProfile().role == 'super_admin'
          || request.resource.data.action in [
            'CREATE_APPOINTMENT', 'UPDATE_APPOINTMENT', 'CANCEL_APPOINTMENT',
            'ACCEPT_BOOKING_REQUEST', 'REJECT_BOOKING_REQUEST',
            'RECORD_MEASUREMENTS'
          ]
        )
        && (
          userProfile().role == 'super_admin'
          || (
            request.resource.data.action in ['CREATE_APPOINTMENT', 'UPDATE_APPOINTMENT', 'CANCEL_APPOINTMENT']
            && request.resource.data.targetType == 'appointment'
          )
          || (
            request.resource.data.action in ['ACCEPT_BOOKING_REQUEST', 'REJECT_BOOKING_REQUEST']
            && request.resource.data.targetType == 'booking_request'
          )
          || (
            request.resource.data.action == 'RECORD_MEASUREMENTS'
            && request.resource.data.targetType == 'measurement'
          )

        )
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 2000
        && isNullableString(request.resource.data.targetId, 160)
        && isNullableString(request.resource.data.targetType, 80)
        && isNullableString(request.resource.data.centerId, 80)
        && isNullableString(request.resource.data.centerName, 160)
        && (userProfile().role == 'super_admin' || request.resource.data.centerId == userProfile().centerId);
    }

    function acceptedBookingReferencesAreIsolated() {
      let client = getAfter(
        /databases/$(database)/documents/clients/$(request.resource.data.clientId)
      ).data;
      let appointment = getAfter(
        /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
      ).data;
      return client.centerId == resource.data.centerId
        && (!('status' in client) || client.status == 'active')
        && client.phone == resource.data.phone
        && appointment.id == request.resource.data.appointmentId
        && appointment.centerId == resource.data.centerId
        && appointment.clientId == request.resource.data.clientId
        && appointment.status == 'booked'
        && appointment.dateTime == resource.data.bookingDate + 'T' + resource.data.bookingTime;
    }

    function isBookingRequestDecision() {
      return resource.data.status == 'pending'
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.processedByUserId == request.auth.uid
        && request.resource.data.processedAt is string
        && (
          (
            request.resource.data.status == 'accepted'
            && request.resource.data.clientId is string
            && request.resource.data.appointmentId is string
            && request.resource.data.acceptedAt == request.resource.data.processedAt
            && acceptedBookingReferencesAreIsolated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'clientId', 'appointmentId', 'processedAt',
              'processedByUserId', 'processedByUserName', 'acceptedAt'
            ])
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectedAt == request.resource.data.processedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'processedAt', 'processedByUserId',
              'processedByUserName', 'rejectedAt'
            ])
          )
        );
    }
    function isClientCreate(clientId) {
      return request.resource.data.keys().hasOnly([
          'id', 'firstName', 'lastName', 'email', 'phone', 'centerId', 'createdAt',
          'status', 'updatedAt', 'notes', 'gender', 'dob', 'bloodType', 'profession',
          'emergencyContactName', 'emergencyContactPhone', 'medicalConditions',
          'sportGoals', 'avatarUrl'
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.id == clientId
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 160
        && request.resource.data.centerId is string
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['H', 'F'])
        && (!('sportGoals' in request.resource.data) || isPublicTextList(request.resource.data.sportGoals, 20, 120))
        && !request.resource.data.keys().hasAny([
          'archivedAt', 'archivedByUserId', 'archivedByUserName',
          'suspendedAt', 'reactivatedAt'
        ]);
    }
    function isBookedAppointmentCreate(appointmentId) {
      return request.resource.data.keys().hasOnly([
          'id', 'clientId', 'serviceId', 'centerId', 'dateTime', 'duration',
          'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'booked'
        && request.resource.data.id == appointmentId
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 160
        && request.resource.data.centerId is string
        && request.resource.data.clientId is string
        && request.resource.data.serviceId is string
        && request.resource.data.dateTime is string
        && request.resource.data.dateTime.size() <= 40
        && request.resource.data.duration is number
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 240
        && (!('notes' in request.resource.data) || (
          request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        ))
        && isActiveClientForCenterAfter(
          request.resource.data.clientId,
          request.resource.data.centerId
        )
        && isKnownService(request.resource.data.serviceId)
        && !request.resource.data.keys().hasAny([
          'completedAt', 'completedByUserId', 'completedByUserName',
          'completedWithClientPackageId', 'deductedCredits',
          'cancelledAt', 'cancelledByUserId', 'cancelledByUserName'
        ]);
    }
    function isAppointmentReschedule() {
      return resource.data.status == 'booked'
        && request.resource.data.status == 'booked'
        && request.resource.data.id == resource.data.id
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.dateTime is string
        && request.resource.data.dateTime.size() <= 40
        && request.resource.data.duration is number
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 240
        && isActiveClientForCenterAfter(
          request.resource.data.clientId,
          resource.data.centerId
        )
        && isKnownService(request.resource.data.serviceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId', 'serviceId', 'dateTime', 'duration', 'notes', 'updatedAt'
        ]);
    }

    function isAppointmentCancellation() {
      return resource.data.status == 'booked'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.id == resource.data.id
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.serviceId == resource.data.serviceId
        && request.resource.data.dateTime == resource.data.dateTime
        && request.resource.data.duration == resource.data.duration
        && request.resource.data.cancelledByUserId == request.auth.uid
        && request.resource.data.cancelledAt is string
        && request.resource.data.cancellationReason is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledByUserId', 'cancelledByUserName',
          'cancellationReason', 'updatedAt'
        ]);
    }

    function isValidMeasurementWrite(measurementId, centerId) {
      return request.resource.data.keys().hasOnly([
          'id', 'clientId', 'centerId', 'date', 'weight', 'bodyFat', 'muscleMass',
          'chest', 'waist', 'hips', 'thighs', 'loggedBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == measurementId
        && request.resource.data.centerId == centerId
        && request.resource.data.clientId is string
        && isActiveClientForCenterAfter(request.resource.data.clientId, centerId)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.weight is number
        && request.resource.data.weight > 0
        && request.resource.data.weight <= 500
        && (!('bodyFat' in request.resource.data) || isOptionalNumber(request.resource.data.bodyFat, 0, 100))
        && (!('muscleMass' in request.resource.data) || isOptionalNumber(request.resource.data.muscleMass, 0, 100))
        && (!('chest' in request.resource.data) || isOptionalNumber(request.resource.data.chest, 0, 400))
        && (!('waist' in request.resource.data) || isOptionalNumber(request.resource.data.waist, 0, 400))
        && (!('hips' in request.resource.data) || isOptionalNumber(request.resource.data.hips, 0, 400))
        && (!('thighs' in request.resource.data) || isOptionalNumber(request.resource.data.thighs, 0, 400))
        && request.resource.data.loggedBy is string
        && request.resource.data.loggedBy.size() > 0
        && request.resource.data.loggedBy.size() <= 160;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      // Les roles et revocations sont administres uniquement par Firebase Admin.
      allow create, update, delete: if false;
    }

    match /centers/{centerId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /managers/{managerId} {
      allow read: if isSuperAdmin() || isCenterManager(resource.data.centerId);
      // Le cycle de vie Auth + profil + manager passe par /api/crm-managers.
      allow create, update, delete: if false;
    }

    match /clients/{clientId} {
      allow get: if (isActiveCrmUser() && !exists(/databases/$(database)/documents/clients/$(clientId)))
        || canAccessCenter(resource.data.centerId);
      allow list: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId)
        && isClientCreate(clientId);
      // Profile edits, suspension and archival are handled by /api/crm-clients.
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get: if (isActiveCrmUser() && !exists(/databases/$(database)/documents/appointments/$(appointmentId)))
        || canAccessCenter(resource.data.centerId);
      allow list: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId)
        && isBookedAppointmentCreate(appointmentId);
      // Session completion and credit mutations are handled by the authenticated
      // /api/crm-operations route through Firebase Admin.
      allow update: if canAccessCenter(resource.data.centerId)
        && canAccessCenter(request.resource.data.centerId)
        && (isAppointmentReschedule() || isAppointmentCancellation());
      allow delete: if false;
    }

    match /client_packages/{clientPackageId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create, update, delete: if false;
    }

    match /measurements/{measurementId} {
      allow read: if canAccessCenter(resource.data.centerId);
      allow create: if canAccessCenter(request.resource.data.centerId)
        && isValidMeasurementWrite(measurementId, request.resource.data.centerId);
      allow update: if canAccessCenter(resource.data.centerId)
        && request.resource.data.centerId == resource.data.centerId
        && isValidMeasurementWrite(measurementId, resource.data.centerId);
      allow delete: if canAccessCenter(resource.data.centerId);
    }

    match /appointment_slots/{centerId}/slots/{slotId} {
      allow read: if canAccessCenter(centerId);
      allow create: if canAccessCenter(centerId) && request.resource.data.centerId == centerId;
      allow update: if canAccessCenter(centerId)
        && resource.data.centerId == centerId
        && request.resource.data.centerId == centerId;
      allow delete: if canAccessCenter(centerId) && resource.data.centerId == centerId;
    }

    match /public_booking_slots/{centerId}/slots/{slotId} {
      allow read: if true;
      allow create: if canAccessCenter(centerId) && request.resource.data.centerId == centerId;
      allow update: if canAccessCenter(centerId)
        && resource.data.centerId == centerId
        && request.resource.data.centerId == centerId;
      allow delete: if canAccessCenter(centerId) && resource.data.centerId == centerId;
    }

    match /booking_requests/{requestId} {
      allow create: if false;
      allow read: if canAccessCenter(resource.data.centerId);
      allow update: if canAccessCenter(resource.data.centerId)
        && canAccessCenter(request.resource.data.centerId)
        && isBookingRequestDecision();
      allow delete: if false;
    }

    match /contact_messages/{messageId} {
      // Public submissions pass through the rate-limited server API.
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if isSuperAdmin() || resource.data.status == 'published';
      // Le cycle editorial passe par l API serveur afin de valider le contenu,
      // l unicite du slug et la tracabilite des publications.
      allow create, update, delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuditLogCreate();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
